# ─── Trackshpr Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All EXPO_PUBLIC_ variables are bundled into the JS bundle — never put secrets here.

# ── Supabase ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-publishable-key

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
#
# Web client ID  — required for Android native sign-in to return an idToken
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
#
# iOS client ID  — native iOS bundle (requires EAS build or bare workflow)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
#
# Android client ID — native Android (requires EAS build or bare workflow)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# ─── Setup checklist ─────────────────────────────────────────────────────────
# 1. npx expo install expo-auth-session expo-crypto
# 2. Supabase dashboard → Authentication → Providers → Google → enable, paste Web client ID + secret
# 3. Google Cloud Console → Authorized redirect URIs → add:
#      https://auth.expo.io/@your-expo-username/Trackshpr   (Expo Go dev)
#      trackshpr://                                          (production)
# 4. app.json already has scheme: "trackshpr" ✓
