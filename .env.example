# ─── Trackshpr Environment Variables ────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# All EXPO_PUBLIC_ variables are bundled into the JS bundle — never put
# secrets here. Secrets (service role key, Paystack secret key, etc.)
# live only in Supabase Edge Functions.

# ── Supabase (required) ───────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-anon-key

# ── Google OAuth (optional) ─────────────────────────────────────────────────────
# No longer required — browser-based OAuth is used instead.
# Kept for potential future native sign-in if needed.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ── Public web origin for tracking links ───────────────────────────────────────────
# Used to build rider / customer tracking URLs.
# Defaults to https://trackshpr.app if not set.
# EXPO_PUBLIC_TRACKSHPR_WEB_URL=https://trackshpr.app

# ── Payments (Paystack) — optional ───────────────────────────────────────────────
# Enable once Paystack keys + Edge Functions are deployed.
# EXPO_PUBLIC_PAYMENTS_ENABLED=false
# EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_PAYSTACK_ENV=test
# EXPO_PUBLIC_PRO_MONTHLY_KOBO=500000

# ── Error monitoring (Sentry) — optional ─────────────────────────────────────────────
# Leave DSN blank to disable.
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_ENV=production
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0