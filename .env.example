# ─── Trackshpr Environment Variables ────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# All EXPO_PUBLIC_ variables are bundled into the JS bundle — never put
# secret keys here. Secrets (service role, Paystack secret, Termii api key
# if you choose to proxy it) live only in Supabase Edge Functions.

# ── Supabase (required) ───────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-publishable-key

# ── Public web origin for tracking links ──────────────────────────────────────
# Used to build rider / customer tracking URLs, e.g.
#   https://trackshpr.app/track-link?token=...
# Set this to your production web domain before shipping.
EXPO_PUBLIC_TRACKSHPR_WEB_URL=https://trackshpr.app

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
#
# Web client ID  — required for Android native sign-in to return an idToken
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
#
# iOS client ID  — native iOS bundle (requires EAS build or bare workflow)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
#
# Android client ID — native Android (requires EAS build or bare workflow)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# ── Termii (server-only — set on the Supabase Edge Function) ─────────────────
# These are NOT in the client bundle. Set via:
#   supabase secrets set TERMII_API_KEY=...
#   supabase secrets set TERMII_SENDER_ID=Trackshpr
#   supabase secrets set TERMII_BASE_URL=https://api.ng.termii.com   (optional)
#   supabase secrets set TERMII_SMS_CHANNEL=generic                  (optional)
# The `send-notification` Edge Function reads these at runtime.

# ── Payments (Paystack) ───────────────────────────────────────────────────────
# Master switch — when false the app shows the Pro waitlist card instead of
# a pay CTA. Flip to "true" once Paystack keys + Edge Functions are live.
EXPO_PUBLIC_PAYMENTS_ENABLED=false
# Paystack keys from https://dashboard.paystack.com/#/settings/developers
# Only the PUBLIC key goes in the bundle. The secret key lives in the
# Supabase Edge Function environment.
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "test" or "live" — flips UI labels and picks the matching key.
EXPO_PUBLIC_PAYSTACK_ENV=test
# Monthly Pro price in kobo. 500000 kobo = ₦5,000.00.
EXPO_PUBLIC_PRO_MONTHLY_KOBO=500000
# Supabase Edge Function names (see DEPLOYMENT.md).
EXPO_PUBLIC_PAYSTACK_INIT_ENDPOINT=paystack-initialize
EXPO_PUBLIC_PAYSTACK_VERIFY_ENDPOINT=paystack-verify

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────
# Optional. Leave DSN blank in dev to skip sending events. Get one from
# https://sentry.io → create project → Copy DSN.
EXPO_PUBLIC_SENTRY_DSN=
# "production" | "staging" | "development" — free-form label for Sentry.
EXPO_PUBLIC_SENTRY_ENV=production
# Traces sample rate (0–1). 0 = performance monitoring off.
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Set to "true" to force-enable Sentry during __DEV__.
EXPO_PUBLIC_SENTRY_ENABLE_DEV=false

# ─── Setup checklist ─────────────────────────────────────────────────────────
# 1. npx expo install expo-auth-session expo-crypto
# 2. Supabase dashboard → Authentication → Providers → Google → enable, paste Web client ID + secret
# 3. Google Cloud Console → Authorized redirect URIs → add:
#      https://auth.expo.io/@your-expo-username/Trackshpr   (Expo Go dev)
#      trackshpr://                                          (production)
# 4. app.json already has scheme: "trackshpr" ✓
# 5. Supabase → Edge Functions → deploy paystack-initialize + paystack-verify
#    with PAYSTACK_SECRET_KEY set in the function environment.
# 6. Termii: register Sender ID in the dashboard before going live.
