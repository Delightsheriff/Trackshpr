# Trackshpr public environment variables
# Copy this file to `.env.local` and fill in real values.
# Only `EXPO_PUBLIC_*` values belong here. Never place secrets in this file.
# Secrets such as service-role keys, Paystack secret keys, Termii keys, and
# OAuth client secrets should live in Supabase/Vercel/EAS secret stores only.

# Required: Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-publishable-or-anon-key

# Recommended: public web origin for tracking links
# Use your deployed web app URL in production.
EXPO_PUBLIC_TRACKSHPR_WEB_URL=https://trackshpr.app

# Optional: payments
# Enable only after the Paystack Edge Functions are deployed and verified.
# EXPO_PUBLIC_PAYMENTS_ENABLED=false
# EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_PAYSTACK_ENV=test
# EXPO_PUBLIC_PRO_MONTHLY_KOBO=500000

# Optional: monitoring
# Leave DSN blank to disable Sentry entirely.
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_ENV=production
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Legacy / optional
# The current OAuth flow does not require this client-side value, but you can
# keep it locally if you later switch back to a Google client-driven flow.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
