{
  "expo": {
    "name": "Trackshpr",
    "slug": "Trackshpr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./generated-assets/icons/icon.png",
    "scheme": "trackshpr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.trackshpr.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./generated-assets/icons/android-icon-foreground.png",
        "backgroundImage": "./generated-assets/icons/android-icon-background.png",
        "monochromeImage": "./generated-assets/icons/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./generated-assets/icons/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./generated-assets/icons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4647D3",
          "dark": {
            "backgroundColor": "#4647D3"
          }
        }
      ],
      "expo-localization",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
